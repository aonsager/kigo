.afk/
# macOS Finder metadata.
.DS_Store
Kigo.xcodeproj/
# Generated by `xcodegen generate` from project.yml's entitlements.properties
# (same treatment as the generated Kigo.xcodeproj — ADR 0003).
*.entitlements
# Build product dir used by C8's evidence (xcodebuild -derivedDataPath build).
build/
# SwiftPM build dir for the KigoCore package (fast-lane `swift test` byproducts).
KigoCore/.build/
# Xcode/SwiftPM per-user package state for KigoCore (not source of truth).
KigoCore/.swiftpm/
.claude/worktrees/
TestResults*
*.xcresult
xcodebuild.log
# Python bytecode cache from the loop-analysis scripts (scripts/afk-retro.py etc.)
__pycache__/
*.pyc
